---
import Layout from './Layout.astro';
import NewsCard from './NewsCard.astro';
import { content, nameOf, homeOf, type Lang } from '../lib/site';
import { posts } from '../lib/news';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content(lang);
const home = homeOf(lang);
const list = posts();
---
<Layout lang={lang} path={`${home}news/`} altPath={`${homeOf(lang === 'ar' ? 'en' : 'ar')}news/`} title={`${t.news.title} | ${nameOf(lang)}`}>
  <section class="bg-dark text-white">
    <div class="max-w-6xl mx-auto px-5 py-16">
      <span class="text-accent font-bold text-sm">{t.news.eyebrow}</span>
      <h1 class="text-4xl font-bold mt-2">{t.news.title}</h1>
    </div>
  </section>
  <section class="max-w-6xl mx-auto px-5 py-16">
    {list.length > 0
      ? <div class="grid grid-cols-[minmax(0,1fr)] sm:grid-cols-2 lg:grid-cols-3 gap-5">{list.map((p) => <NewsCard lang={lang} post={p} />)}</div>
      : <p class="text-center text-slate-500 py-16">{t.news.empty}</p>}
  </section>
</Layout>
