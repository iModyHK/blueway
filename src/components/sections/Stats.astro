---
import { s, on, content, nameOf, homeOf, img, icons, social, fallbackFor, initials, phoneHref, type Lang } from '../../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content(lang);
const name = nameOf(lang);
const home = homeOf(lang);
const showStats = (t.stats ?? []).length > 0;
---
{showStats && (
    <section class="max-w-6xl mx-auto px-5 -mt-10 relative z-10">
      <div class="grid grid-cols-2 md:grid-cols-4 bg-white rounded-2xl shadow-xl shadow-slate-200/70 border border-slate-100 [&>*:not(:first-child)]:border-s [&>*]:border-slate-100">
        {t.stats.map((x: any) => <div class="p-6 text-center"><div class="text-3xl font-bold text-primary">{x.value}</div><div class="text-sm text-slate-500 mt-1">{x.label}</div></div>)}
      </div>
    </section>
  )}
