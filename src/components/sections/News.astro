---
import { content, homeOf, type Lang } from '../../lib/site';
import { posts } from '../../lib/news';
import NewsCard from '../NewsCard.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content(lang);
const list = posts().slice(0, 3);
---
{list.length > 0 && (
  <section id="news" class="max-w-6xl mx-auto px-5 py-24">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
      <div>
        <span class="text-primary font-bold text-sm">{t.news.eyebrow}</span>
        <h2 class="text-3xl md:text-4xl font-bold text-dark mt-2">{t.news.title}</h2>
      </div>
      <a href={`${homeOf(lang)}news/`} class="inline-flex items-center gap-2 self-start rounded-full border border-slate-300 px-5 py-2.5 text-sm font-bold text-dark hover:bg-dark hover:text-white hover:border-dark transition">{t.news.all}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
    </div>
    <div class="grid grid-cols-[minmax(0,1fr)] sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {list.map((p) => <NewsCard lang={lang} post={p} />)}
    </div>
  </section>
)}
