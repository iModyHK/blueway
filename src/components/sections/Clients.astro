---
import { s, on, content, nameOf, homeOf, img, icons, social, fallbackFor, initials, phoneHref, type Lang } from '../../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content(lang);
const name = nameOf(lang);
const home = homeOf(lang);

---
{t.clients.items.length > 0 && (
    <section id="clients" class="max-w-6xl mx-auto px-5 py-24">
      <div class="text-center mb-12">
        <span class="text-primary font-bold text-sm">{t.clients.eyebrow}</span>
        <h2 class="text-3xl font-bold text-dark mt-2">{t.clients.title}</h2>
      </div>
      <div class="relative">
        <div id="cl-track" class="flex gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
          {t.clients.items.map((x: any) => (
            <div class="cl-card group snap-start shrink-0 w-[calc(50%-10px)] sm:w-[calc(33.333%-14px)] lg:w-[calc(25%-15px)] rounded-3xl p-px bg-gradient-to-b from-slate-200 to-slate-100 transition duration-500 hover:from-primary hover:to-accent hover:shadow-xl hover:shadow-primary/15">
              <div class="h-full rounded-[calc(1.5rem-1px)] bg-white px-5 pt-8 pb-6 flex flex-col items-center text-center">
                <div class="h-20 w-full grid place-items-center mb-5">
                  {x.logo
                    ? <img src={img(x.logo)} alt={x.name} loading="lazy" class="max-h-14 max-w-[75%] w-auto object-contain transition duration-500 group-hover:scale-105" />
                    : <span class="h-16 min-w-16 px-3 rounded-2xl grid place-items-center text-xl font-bold tracking-wide text-white shadow-lg shadow-primary/25" style="background:linear-gradient(135deg,var(--brand-accent),var(--brand-primary))">{x.short || initials(x.name)}</span>}
                </div>
                <div class="w-8 h-px bg-slate-200 mb-4 transition-all duration-500 group-hover:w-14 group-hover:bg-accent"></div>
                <span class="font-bold text-dark text-sm leading-snug">{x.name}</span>
              </div>
            </div>
          ))}
        </div>
        <div id="cl-nav" class="hidden mt-8 items-center justify-center gap-3">
          <button type="button" data-cl="-1" aria-label="prev" class="w-11 h-11 rounded-full border border-slate-300 grid place-items-center text-dark hover:bg-dark hover:text-white hover:border-dark transition"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180"><path d="M15 6l-6 6 6 6" /></svg></button>
          <div id="cl-dots" class="flex items-center"></div>
          <button type="button" data-cl="1" aria-label="next" class="w-11 h-11 rounded-full bg-dark text-white grid place-items-center hover:bg-primary transition"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="rtl:rotate-180"><path d="M9 6l6 6-6 6" /></svg></button>
        </div>
      </div>
    </section>
  )}


  <script is:inline>
    (function () {
      var track = document.getElementById('cl-track');
      if (!track) return;
      var nav = document.getElementById('cl-nav'), dots = document.getElementById('cl-dots');
      var cards = [].slice.call(track.children);
      var rtl = document.documentElement.dir === 'rtl';
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var timer = null, hovered = false, visible = false, pages = 1;
      function perView() { var w = cards[0].getBoundingClientRect().width + 20; return Math.max(1, Math.round((track.clientWidth + 20) / w)); }
      function pos() { return Math.abs(track.scrollLeft); }
      function step() { return cards[0].getBoundingClientRect().width + 20; }
      function page() { return Math.round(pos() / (step() * perView())); }
      function go(n) {
        var max = track.scrollWidth - track.clientWidth;
        var target = Math.min(n * step() * perView(), max);
        if (n >= pages) target = 0;
        if (n < 0) target = max;
        track.scrollTo({ left: rtl ? -target : target, behavior: 'smooth' });
      }
      function paint() {
        var p = page();
        [].forEach.call(dots.children, function (d, i) { d.firstChild.className = 'block h-2 rounded-full transition-all ' + (i === p ? 'w-6 bg-primary' : 'w-2 bg-slate-300'); });
      }
      function setup() {
        var overflow = track.scrollWidth - track.clientWidth > 4;
        nav.classList.toggle('hidden', !overflow);
        nav.classList.toggle('flex', overflow);
        track.classList.toggle('justify-center', !overflow);
        pages = overflow ? Math.ceil(cards.length / perView()) : 1;
        dots.innerHTML = '';
        for (var i = 0; i < pages; i++) { var d = document.createElement('button'); d.type = 'button'; d.className = 'p-2'; d.setAttribute('aria-label', String(i + 1)); d.appendChild(document.createElement('span')); d.addEventListener('click', (function (k) { return function () { go(k); restart(); }; })(i)); dots.appendChild(d); }
        paint();
        restart();
      }
      function restart() {
        clearInterval(timer);
        if (!reduce && visible && !hovered && pages > 1) timer = setInterval(function () { go(page() + 1); }, 4000);
      }
      document.querySelectorAll('[data-cl]').forEach(function (b) { b.addEventListener('click', function () { go(page() + Number(b.dataset.cl)); restart(); }); });
      track.addEventListener('scroll', function () { window.requestAnimationFrame(paint); }, { passive: true });
      track.addEventListener('mouseenter', function () { hovered = true; restart(); });
      track.addEventListener('mouseleave', function () { hovered = false; restart(); });
      track.addEventListener('touchstart', function () { hovered = true; restart(); }, { passive: true });
      track.addEventListener('touchend', function () { hovered = false; restart(); });
      new IntersectionObserver(function (es) { visible = es[0].isIntersecting; restart(); }, { threshold: 0.3 }).observe(track);
      window.addEventListener('resize', setup);
      setup();
    })();
  </script>
