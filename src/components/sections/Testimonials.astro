---
import { content, img, initials, type Lang } from '../../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content(lang);
const items: any[] = t.testimonials?.items ?? [];
---
{items.length > 0 && (
  <section id="testimonials" class="bg-slate-50 py-24 overflow-x-clip">
    <div class="max-w-6xl mx-auto px-5">
      <div class="text-center mb-12">
        <span class="text-primary font-bold text-sm">{t.testimonials.eyebrow}</span>
        <h2 class="text-3xl md:text-4xl font-bold text-dark mt-2">{t.testimonials.title}</h2>
      </div>
      <div class="flex gap-5 overflow-x-auto snap-x snap-mandatory pb-4 -mx-5 px-5 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
        {items.map((x) => (
          <figure class="snap-start shrink-0 w-[85%] sm:w-[calc(50%-10px)] lg:w-[calc(33.333%-14px)] flex flex-col rounded-3xl bg-white p-7 ring-1 ring-slate-200/70">
            <svg width="36" height="36" viewBox="0 0 24 24" fill="currentColor" class="text-accent mb-4 rtl:-scale-x-100" aria-hidden="true"><path d="M9.6 6C6.5 7.3 4.5 10 4.5 13.4V18h6v-6H7.5c0-2 1.2-3.6 3-4.4zm9 0c-3.1 1.3-5.1 4-5.1 7.4V18h6v-6h-3c0-2 1.2-3.6 3-4.4z" /></svg>
            {Number(x.rating) > 0 && (
              <div class="flex gap-0.5 mb-3 text-amber-400" aria-label={`${x.rating}/5`}>
                {[1, 2, 3, 4, 5].map((n) => <svg width="16" height="16" viewBox="0 0 24 24" fill={n <= Number(x.rating) ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.5"><path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1 6.2L12 17.3 6.5 20.2l1-6.2L3 9.6l6.2-.9z" /></svg>)}
              </div>
            )}
            <blockquote class="flex-1 leading-loose text-slate-600">{x.quote}</blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-slate-100 pt-5">
              {x.image
                ? <img src={img(x.image)} alt={x.name} loading="lazy" class="w-12 h-12 rounded-full object-cover bg-slate-100" />
                : <span class="w-12 h-12 shrink-0 rounded-full grid place-items-center text-sm font-bold text-white" style="background:linear-gradient(135deg,var(--brand-accent),var(--brand-primary))">{initials(x.name)}</span>}
              <div class="min-w-0">
                <div class="font-bold text-dark">{x.name}</div>
                {(x.role || x.company) && <div class="text-sm text-slate-500">{[x.role, x.company].filter(Boolean).join(' — ')}</div>}
              </div>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
