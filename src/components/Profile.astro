---
import '../styles/global.css';
import Head from './Head.astro';
import QRCode from 'qrcode';
import { s, on, content, nameOf, img, icons, initials, siteUrl, homeOf, abs, type Lang } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = content(lang);
const name = nameOf(lang);
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const url = siteUrl() && !/example\.com/.test(siteUrl()) ? abs(homeOf(lang)) : '';
const qr = url ? await QRCode.toString(url, { type: 'svg', margin: 0, color: { dark: s.dark, light: '#0000' } }) : '';
const stats = on('stats') ? t.stats ?? [] : [];
const clients = on('clients') ? t.clients?.items ?? [] : [];
const certs = on('certificates') ? t.certificates?.items ?? [] : [];
const projects = on('projects') ? (t.projects?.items ?? []).slice(0, 6) : [];
const services = t.services?.items ?? [];
---
<!doctype html>
<html lang={lang} dir={dir}>
<head>
  <Head lang={lang} path={lang === 'ar' ? '/profile/' : '/en/profile/'} altPath={lang === 'ar' ? '/en/profile/' : '/profile/'} title={`${t.profile.title} | ${name}`} noindex />
  <style is:global>
    @page { size: A4; margin: 0; }
    html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    body { background: #e2e8f0; }
    .sheet { width: 210mm; height: 297mm; margin: 0 auto 10mm; background: #fff; position: relative; overflow: hidden; box-shadow: 0 10px 40px rgb(15 23 42 / .15); break-after: page; }
    .sheet:last-of-type { break-after: auto; }
    @media print { body { background: #fff; } .sheet { margin: 0; box-shadow: none; } .no-print { display: none !important; } }
  </style>
</head>
<body class="font-sans text-slate-700 antialiased py-8 print:py-0">
  <div class="no-print sticky top-4 z-10 mx-auto mb-6 flex w-[210mm] max-w-full items-center justify-between rounded-full bg-dark px-5 py-3 text-white shadow-lg">
    <a href={homeOf(lang)} class="text-sm text-white/80 hover:text-white">← {name}</a>
    <button type="button" onclick="window.print()" class="inline-flex items-center gap-2 rounded-full bg-accent px-4 py-1.5 text-sm font-bold text-dark"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={icons.download} /></svg>{t.profile.print}</button>
  </div>

  <section class="sheet text-white" style="background:linear-gradient(150deg,var(--brand-dark) 0%,var(--brand-dark) 45%,var(--brand-primary) 100%)">
    <div class="absolute inset-0 opacity-[0.07]" style="background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:12mm 12mm"></div>
    <div class="absolute -top-[40mm] -end-[40mm] h-[140mm] w-[140mm] rounded-full opacity-25" style="background:radial-gradient(var(--brand-accent),transparent 65%)"></div>
    <svg class="absolute bottom-0 inset-x-0 w-full text-white/[0.07]" viewBox="0 0 1440 200" preserveAspectRatio="none" fill="currentColor"><path d="M0 120c240-60 480-60 720 0s480 60 720 0v80H0z" /><path d="M0 150c240-40 480-40 720 0s480 40 720 0v50H0z" /></svg>
    <div class="relative flex h-full flex-col px-[18mm] py-[20mm]">
      <div class="text-sm font-bold tracking-[0.3em] uppercase text-accent">{t.profile.title}</div>
      <div class="flex flex-1 flex-col items-center justify-center text-center">
        {s.logo_white ? <img src={img(s.logo_white)} alt={name} class="h-[95mm] w-auto" /> : s.logo ? <div class="grid h-[70mm] w-[70mm] place-items-center rounded-full bg-white p-[12mm]"><img src={img(s.logo)} alt={name} class="w-full" /></div> : <div class="text-6xl font-bold">{name}</div>}
        <p class="mt-[12mm] max-w-[140mm] text-xl leading-relaxed text-white/85">{t.tagline}</p>
      </div>
      <div class="flex items-end justify-between gap-6 border-t border-white/15 pt-[8mm] text-sm">
        <div class="space-y-1.5 text-white/85">
          {s.phone && <div class="flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={icons.phone} /></svg><span dir="ltr">{s.phone}</span></div>}
          {s.email && <div class="flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={icons.mail} /></svg><span dir="ltr">{s.email}</span></div>}
          <div class="flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={icons.pin} /></svg>{t.contact.address}</div>
        </div>
        {qr && <div class="h-[24mm] w-[24mm] rounded-lg bg-white p-[2mm]" set:html={qr.replace(s.dark, s.dark)} />}
      </div>
    </div>
  </section>

  <section class="sheet">
    <div class="h-[6mm]" style="background:linear-gradient(90deg,var(--brand-primary),var(--brand-accent))"></div>
    <div class="px-[18mm] py-[14mm]">
      <div class="text-sm font-bold text-primary">{t.about.eyebrow}</div>
      <h2 class="mt-1 text-3xl font-bold text-dark">{t.about.title}</h2>
      <p class="mt-4 text-[15px] leading-loose">{t.about.text}</p>
      {t.about.points?.length > 0 && (
        <ul class="mt-5 grid grid-cols-2 gap-x-6 gap-y-2.5">
          {t.about.points.map((p: any) => <li class="flex items-start gap-2.5 text-sm"><span class="mt-0.5 grid h-5 w-5 shrink-0 place-items-center rounded-full bg-primary/10 text-primary"><svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5"><path d="M5 12l5 5L20 7" /></svg></span>{p.text}</li>)}
        </ul>
      )}
      {stats.length > 0 && (
        <div class="mt-8 grid grid-cols-4 overflow-hidden rounded-2xl bg-slate-50 ring-1 ring-slate-200">
          {stats.map((x: any) => <div class="p-4 text-center"><div class="text-2xl font-bold text-primary">{x.value}</div><div class="mt-1 text-xs text-slate-500">{x.label}</div></div>)}
        </div>
      )}
      <div class="mt-10 flex items-end justify-between">
        <div>
          <div class="text-sm font-bold text-primary">{t.services.eyebrow}</div>
          <h2 class="mt-1 text-3xl font-bold text-dark">{t.services.title}</h2>
        </div>
      </div>
      <div class="mt-5 grid grid-cols-2 gap-4">
        {services.map((x: any, i: number) => (
          <div class={`rounded-2xl p-5 ring-1 ring-slate-200 ${services.length % 2 === 1 && i === services.length - 1 ? 'col-span-2' : ''}`}>
            <div class="flex items-center gap-3">
              <div class="grid h-10 w-10 shrink-0 place-items-center rounded-xl text-white" style="background:linear-gradient(135deg,var(--brand-accent),var(--brand-primary))"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={icons[x.icon] ?? icons.building} /></svg></div>
              <h3 class="font-bold leading-snug text-dark">{x.title}</h3>
            </div>
            <p class="mt-3 text-[13px] leading-relaxed text-slate-500">{x.text}</p>
            {x.details?.length > 0 && <ul class="mt-2 space-y-1">{x.details.map((d: any) => <li class="flex items-start gap-2 text-[12px]"><span class="mt-[6px] h-1.5 w-1.5 shrink-0 rounded-full bg-accent"></span>{d.text}</li>)}</ul>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="sheet">
    <div class="h-[6mm]" style="background:linear-gradient(90deg,var(--brand-primary),var(--brand-accent))"></div>
    <div class="flex h-[calc(297mm-6mm)] flex-col px-[18mm] py-[14mm]">
      {projects.length > 0 && (
        <div class="mb-9">
          <div class="text-sm font-bold text-primary">{t.projects.eyebrow}</div>
          <h2 class="mt-1 text-2xl font-bold text-dark">{t.projects.title}</h2>
          <div class="mt-4 grid grid-cols-3 gap-3">
            {projects.map((x: any) => (
              <div class="overflow-hidden rounded-xl ring-1 ring-slate-200">
                <div class="aspect-[4/3] bg-dark">{x.image && <img src={img(x.image)} alt={x.title} class="h-full w-full object-cover" />}</div>
                <div class="p-2.5"><div class="text-[12px] font-bold text-dark leading-snug">{x.title}</div>{x.location && <div class="text-[11px] text-slate-500">{x.location}</div>}</div>
              </div>
            ))}
          </div>
        </div>
      )}
      {clients.length > 0 && (
        <div class="mb-9">
          <div class="text-sm font-bold text-primary">{t.clients.eyebrow}</div>
          <h2 class="mt-1 text-2xl font-bold text-dark">{t.clients.title}</h2>
          <div class="mt-4 grid grid-cols-4 gap-3">
            {clients.map((x: any) => (
              <div class="flex flex-col items-center rounded-xl px-3 py-4 text-center ring-1 ring-slate-200">
                <div class="grid h-14 w-full place-items-center">{x.logo ? <img src={img(x.logo)} alt={x.name} class="max-h-12 max-w-[80%] object-contain" /> : <span class="grid h-12 min-w-12 place-items-center rounded-xl px-2 font-bold text-white" style="background:linear-gradient(135deg,var(--brand-accent),var(--brand-primary))">{x.short || initials(x.name)}</span>}</div>
                <div class="mt-2 text-[11px] font-bold leading-snug text-dark">{x.name}</div>
              </div>
            ))}
          </div>
        </div>
      )}
      {certs.length > 0 && (
        <div class="mb-9">
          <div class="text-sm font-bold text-primary">{t.certificates.eyebrow}</div>
          <h2 class="mt-1 text-2xl font-bold text-dark">{t.certificates.title}</h2>
          <div class="mt-4 grid grid-cols-2 gap-3">
            {certs.map((x: any) => <div class="flex items-center gap-3 rounded-xl p-3 ring-1 ring-slate-200"><div class="grid h-10 w-10 shrink-0 place-items-center rounded-lg bg-primary/10 text-primary"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d={icons.award} /></svg></div><div><div class="text-[13px] font-bold text-dark">{x.title}</div><div class="text-[11px] text-slate-500">{[x.issuer, x.number].filter(Boolean).join(' · ')}</div></div></div>)}
          </div>
        </div>
      )}
      <div class="mt-auto rounded-3xl p-[10mm] text-white" style="background:linear-gradient(135deg,var(--brand-dark),var(--brand-primary))">
        <div class="flex items-center justify-between gap-6">
          <div>
            <div class="text-sm font-bold text-accent">{t.profile.contact}</div>
            <div class="mt-1 text-2xl font-bold">{name}</div>
            <div class="mt-4 space-y-2 text-sm text-white/85">
              {s.phone && <div class="flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={icons.phone} /></svg><span dir="ltr">{s.phone}</span></div>}
              {s.email && <div class="flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={icons.mail} /></svg><span dir="ltr">{s.email}</span></div>}
              <div class="flex items-center gap-2"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d={icons.pin} /></svg>{t.contact.address}</div>
              {url && <div class="flex items-center gap-2" dir="ltr">{url.replace(/^https?:\/\//, '').replace(/\/$/, '')}</div>}
            </div>
          </div>
          {s.logo && <div class="grid h-[30mm] w-[30mm] shrink-0 place-items-center rounded-full bg-white p-[5mm]"><img src={img(s.logo)} alt={name} class="w-full" /></div>}
        </div>
      </div>
    </div>
  </section>
</body>
</html>
