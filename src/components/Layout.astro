---
import '../styles/global.css';
import Head from './Head.astro';
import { s, on, content, nameOf, homeOf, img, icons, social, sectionOrder, hasData, type Lang } from '../lib/site';

interface Props { lang: Lang; path: string; altPath: string; title?: string; description?: string; isHome?: boolean }
const { lang, path, altPath, title, description, isHome = false } = Astro.props;
const t = content(lang);
const name = nameOf(lang);
const credit = lang === 'ar' ? s.credit_name_ar : s.credit_name_en;
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const home = homeOf(lang);
const anchor = isHome ? '' : home;
const other = lang === 'ar' ? { label: 'EN' } : { label: 'عربي' };
const nav = sectionOrder().filter((k) => t.nav?.[k] && hasData(k, lang)).map((k) => [k, t.nav[k]]);
const pdf = `/company-profile-${lang}.pdf`;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang} dir={dir}>
<head>
  <Head lang={lang} path={path} altPath={altPath} title={title} description={description} />
  {on('contact') && s.turnstile_site_key && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
</head>
<body class="font-sans text-slate-700 bg-white antialiased">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:start-3 focus:z-50 focus:rounded-lg focus:bg-dark focus:px-4 focus:py-2 focus:text-white">{lang === 'ar' ? 'تخطَّ إلى المحتوى' : 'Skip to content'}</a>
  <header class="sticky top-0 z-30 bg-white/90 backdrop-blur border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-5 h-18 flex items-center justify-between gap-4">
      <a href={home} class="flex items-center gap-2.5 font-bold text-dark text-xl">
        {s.logo
          ? <img src={img(s.logo)} alt={name} class="h-12 w-auto" />
          : <span class="w-9 h-9 rounded-lg bg-primary grid place-items-center text-white"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 18h20M5 18a7 7 0 0114 0" /><path d="M12 4v3" /></svg></span>}
        {name}
      </a>
      <nav class="hidden lg:flex items-center gap-7 text-sm font-medium">
        {nav.map(([id, label]) => <a href={`${anchor}#${id}`} class="hover:text-primary transition">{label}</a>)}
      </nav>
      <div class="flex items-center gap-2">
        {on('profile_download') && <a href={pdf} download class="hidden sm:inline-flex items-center gap-1.5 text-sm font-medium text-primary hover:text-dark transition"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={icons.download} /></svg>{t.profile.button}</a>}
        {on('lang_switch') && <a href={altPath} class="text-sm font-medium border border-slate-200 rounded-full px-4 py-1.5 hover:border-primary hover:text-primary transition">{other.label}</a>}
      </div>
    </div>
  </header>
  <main id="main">
    <slot />
  </main>

  <footer class="bg-dark text-white/55 text-sm border-t border-white/10">
    <div class="max-w-6xl mx-auto px-5 py-6 flex flex-col md:flex-row gap-4 items-center justify-between">
      <div class="flex flex-col sm:flex-row items-center gap-3">
        <span>© {year} {name} — {t.footer.rights}{s.cr && <> · {t.footer.cr}: {s.cr}</>}</span>
        {(s.social ?? []).length > 0 && (
          <div class="flex items-center gap-2">
            {s.social.filter((x: any) => x.url).map((x: any) => <a href={x.url} target="_blank" rel="noopener" aria-label={x.platform} class="w-8 h-8 rounded-full bg-white/10 grid place-items-center text-white/80 hover:bg-white/20 hover:text-white transition"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={social[x.platform] ?? icons.pin} /></svg></a>)}
          </div>
        )}
        {on('profile_download') && <a href={pdf} download class="inline-flex items-center gap-1.5 text-white/70 hover:text-white"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d={icons.download} /></svg>{t.profile.button}</a>}
      </div>
      {on('credit') && s.credit_url && (
        <a href={s.credit_url} target="_blank" rel="noopener" class="group flex items-center gap-2 rounded-full border border-white/15 ps-3 pe-1.5 py-1 hover:border-white/40 transition">
          <span class="text-white/50 text-xs">{t.footer.credit}</span>
          {s.credit_logo
            ? <img src={img(s.credit_logo)} alt={credit} class="h-7 w-auto" />
            : <span class="bg-white text-dark rounded-full px-3 py-0.5 font-bold text-xs">{credit}</span>}
        </a>
      )}
    </div>
  </footer>


  {on('whatsapp') && s.whatsapp && <a href={`https://wa.me/${s.whatsapp}`} target="_blank" rel="noopener" aria-label="WhatsApp" class="fixed bottom-5 end-5 z-40 w-14 h-14 rounded-full bg-[#25d366] text-white grid place-items-center shadow-lg hover:scale-105 transition"><svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 00-8.6 15.1L2 22l5-1.3A10 10 0 1012 2zm0 18.2c-1.5 0-3-.4-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1112 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 01-3.3-2.9c-.2-.4.2-.4.7-1.2.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 00-.7.3 3 3 0 00-.9 2.2 5.2 5.2 0 001.1 2.7 11.8 11.8 0 004.5 4c1.7.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.6-.3z" /></svg></a>}

</body>
</html>
